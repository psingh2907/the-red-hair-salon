# Copy to .env.local and adjust. Never commit .env.local.

# true  = prototype: placeholders allowed, hidden from search engines (default)
# false = production: the build fails if critical business data is missing
NEXT_PUBLIC_PROTOTYPE_MODE=true

# Public URL of the deployed site (canonical links, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prototype only: demo numbers so the WhatsApp and Call flows work live
# before the salon's real numbers are added in src/data/business.ts.
# Use a number you own (for example your own WhatsApp). Ignored in production.
NEXT_PUBLIC_DEMO_WHATSAPP=
NEXT_PUBLIC_DEMO_PHONE=
